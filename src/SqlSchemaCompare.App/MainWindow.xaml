<Window x:Class="SqlSchemaCompare.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SQL Server Schema Compare" Width="1240" Height="850" MinWidth="1000" MinHeight="680" Background="#F4F7FB">
<Window.Resources><Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,3,0,8"/><Setter Property="FontSize" Value="13"/></Style><Style TargetType="PasswordBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,3,0,8"/><Setter Property="FontSize" Value="13"/></Style><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,3"/><Setter Property="FontSize" Value="13"/></Style><Style TargetType="Label"><Setter Property="Foreground" Value="#344054"/><Setter Property="FontWeight" Value="SemiBold"/></Style></Window.Resources>
<DockPanel Margin="26"><StackPanel DockPanel.Dock="Top"><TextBlock Text="SQL SERVER SCHEMA COMPARE" FontSize="26" FontWeight="Bold" Foreground="#172033"/><TextBlock Text="Compare source and target schemas, review the differences, then generate a script for manual execution in SSMS." Foreground="#667085" Margin="0,5,0,12" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Label Content="Connection profile" VerticalAlignment="Center"/><TextBox x:Name="ProfileName" Width="180" Margin="8,3,6,3" ToolTip="Example: Development, Test, Production"/><Button Content="SAVE PROFILE" Click="SaveProfile"/><ComboBox x:Name="Profiles" Width="180" Margin="14,3,6,3"/><Button Content="LOAD PROFILE" Click="LoadProfile"/></StackPanel><Border Background="#E8F1FF" CornerRadius="6" Padding="12" Margin="0,0,0,16"><TextBlock Text="Workflow:  1) Enter connections   →   2) Test connections   →   3) Compare   →   4) Select differences   →   5) Generate script" Foreground="#174EA6" FontWeight="SemiBold"/></Border></StackPanel>
<Grid DockPanel.Dock="Top" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="SOURCE DATABASE  (correct / current schema)" Margin="0,0,10,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Content="Server / Instance"/><TextBox x:Name="SourceServer" Grid.Column="1" ToolTip="Example: 192.168.1.253 or SQL01\SQLEXPRESS"/><Label Content="Database" Grid.Row="1"/><TextBox x:Name="SourceDatabase" Grid.Row="1" Grid.Column="1" ToolTip="Example: ERP_TEST"/><Label Content="Username" Grid.Row="2"/><TextBox x:Name="SourceUser" Grid.Row="2" Grid.Column="1" ToolTip="Leave empty for Windows Authentication"/><Label Content="Password" Grid.Row="3"/><PasswordBox x:Name="SourcePassword" Grid.Row="3" Grid.Column="1" ToolTip="Stored encrypted with Windows DPAPI"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><Button Content="Test source connection" Click="TestSource"/><Button Content="Transfer access details →" Click="TransferSourceAccess" Margin="12,3,0,3"/></StackPanel></Grid></GroupBox><GroupBox Header="TARGET DATABASE  (schema to update)" Grid.Column="1" Margin="10,0,0,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Content="Server / Instance"/><TextBox x:Name="TargetServer" Grid.Column="1" ToolTip="Example: 192.168.1.253 or SQL01\SQLEXPRESS"/><Label Content="Database" Grid.Row="1"/><TextBox x:Name="TargetDatabase" Grid.Row="1" Grid.Column="1" ToolTip="Example: ERP_LIVE"/><Label Content="Username" Grid.Row="2"/><TextBox x:Name="TargetUser" Grid.Row="2" Grid.Column="1" ToolTip="Leave empty for Windows Authentication"/><Label Content="Password" Grid.Row="3"/><PasswordBox x:Name="TargetPassword" Grid.Row="3" Grid.Column="1" ToolTip="Stored encrypted with Windows DPAPI"/><Button Content="Test target connection" Grid.Row="4" Grid.Column="1" Click="TestTarget" HorizontalAlignment="Left"/></Grid></GroupBox></Grid>
<TextBlock DockPanel.Dock="Top" Text="Profiles are stored locally with the password protected by Windows DPAPI. Database names are saved separately for source and target." Foreground="#667085" FontStyle="Italic" Margin="2,0,0,6"/><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><ProgressBar x:Name="ActivityProgress" Width="180" Height="16" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="#667085" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><Button Content="COMPARE SCHEMAS" Click="Compare" Padding="24,10" Background="#2563EB" Foreground="White" FontWeight="Bold"/><Button Content="GENERATE SCRIPT" Click="Generate" Padding="20,10" Margin="12,3,0,3"/><CheckBox x:Name="AllowDestructive" Content="Allow destructive changes (DROP)" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions><GroupBox Header="SCHEMA DIFFERENCES" Grid.Column="0" Margin="0,0,8,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Green = source-only / add   •   Yellow = modified   •   Red = target-only / review required" Foreground="#667085" Margin="8,6"/><CheckBox DockPanel.Dock="Top" Content="Select all differences" IsChecked="True" Click="SelectAllToggle" Margin="8,2,8,6"/><ListView x:Name="Differences"><ListView.View><GridView><GridViewColumn Header="Select" Width="55"><GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Type" DisplayMemberBinding="{Binding ObjectType}" Width="100"/><GridViewColumn Header="Object" DisplayMemberBinding="{Binding ObjectName}" Width="220"/><GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="360"/></GridView></ListView.View></ListView></DockPanel></GroupBox><GroupBox Header="GENERATED SQL — review before executing in SSMS" Grid.Column="1" Margin="8,0,0,0"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="COPY" Click="Copy"/><Button Content="CLEAR" Click="Clear"/><Button Content="SAVE .SQL" Click="Save"/></StackPanel><TextBox x:Name="Script" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10"/></DockPanel></GroupBox></Grid></DockPanel></Window>
